# Required for WalletConnect QR/deep-link flows.
# Create a project at https://cloud.walletconnect.com/.
VITE_WALLET_CONNECT_PROJECT_ID=

# Optional. Defaults to https://ethereum-rpc.publicnode.com for Ethereum mainnet.
VITE_ETHEREUM_RPC_URL=

# Optional. Set to true to enable render profiling by default.
VITE_PERF_ENABLED=false

# Optional. Set to true to default server-side network selection to Hyperliquid testnet.
VITE_HYPERLIQUID_TESTNET=false

# Optional. Set to true to enable preview (paper) trading: simulated $100k balance, local order
# fills, no wallet signatures, and no real orders. Money movement (withdraw/send/transfer) is blocked.
VITE_PAPER_TRADE=false

# Optional. Builder code attached to LIVE orders. Unset (default) = no builder code,
# no builder fee, and no "Builder Fee" row in the order summaries. Preview orders
# are simulated locally and never carry one.
# VITE_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
# Optional. Fee in Hyperliquid builder units (10 = 0.01, max 100). Defaults to 10
# when VITE_BUILDER_ADDRESS is set.
# VITE_BUILDER_FEE=10
